{
  "expo": {
    "name": "BanabaConnect",
    "slug": "banabaconnect",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.banabaconnect.app"
    },
    "android": {
      "package": "ph.banabaconnect.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BanabaConnect uses the camera to take a photo of an incident or of your Barangay ID.",
          "photosPermission": "BanabaConnect uses your photos so you can attach a picture of an incident or of your Barangay ID.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BanabaConnect uses your location while you make a report, so responders know where to go.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "scheme": "banabaconnect"
  }
}
