<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A short buzz tells the resident the pattern was caught, even before the screen opens. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Runs in the foreground with an ongoing notification, so phones don't kill it once the app
         is swiped away. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Off until the resident turns it on in Settings, then Accessibility. -->
        <service
            android:name=".VolumeSosService"
            android:label="@string/volume_sos_label"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_sos_service" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens for the volume-button SOS pattern so a resident can open an emergency report hands-free" />
        </service>
    </application>
</manifest>
